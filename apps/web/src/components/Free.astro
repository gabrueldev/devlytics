---
import { dictionaryFor, type Locale } from "../i18n";
import Coffee from "./Coffee.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
---

<section class="section free">
  <div class="dot-grid" aria-hidden="true"></div>
  <div class="container free-inner reveal">
    <p class="free-price" aria-hidden="true">{locale === "pt" ? "R$ 0" : "$0"}</p>
    <h2 class="section-title">{t.free.title}</h2>
    <p class="section-sub">{t.free.sub}</p>
    <a class="free-author liquid-glass" href="https://gabrueldev.com" rel="noopener">
      <span>{t.free.byStart} <b>{t.free.author}</b></span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    <Coffee locale={locale} />
  </div>
</section>

<style>
  .free {
    overflow: clip;
  }

  .free-inner {
    position: relative;
    max-width: 44rem;
    text-align: center;
  }

  .free-price {
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 10rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(17, 17, 22, 0.16);
    margin-bottom: 0.5rem;
  }

  .free-author {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.95rem;
  }
</style>
