{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "devlytics-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "devlytics.gabrueldev.com/t.js", "zone_name": "gabrueldev.com" },
    { "pattern": "devlytics.gabrueldev.com/e", "zone_name": "gabrueldev.com" },
    { "pattern": "devlytics.gabrueldev.com/health", "zone_name": "gabrueldev.com" },
  ],
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "https://devlytics.gabrueldev.com",
    "MAIL_FROM": "Devlytics <avisos@gabrueldev.com>",
  },
  "assets": { "directory": "../../packages/tracker/dist" },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "devlytics_events" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devlytics",
      "database_id": "2af6c752-881e-4283-ad41-6135fd2b17e7",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
}
