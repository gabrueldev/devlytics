---
import Layout from "../layouts/Layout.astro";
---

<Layout locale="pt">
  <main id="main" class="not-found container">
    <h1>404</h1>
    <p>Esta página não existe. <a href="/">Voltar ao início</a></p>
  </main>
</Layout>

<style>
  .not-found {
    display: grid;
    place-content: center;
    gap: 1rem;
    min-height: 80vh;
    text-align: center;
  }

  h1 {
    font-size: clamp(4rem, 12vw, 7rem);
  }
</style>
