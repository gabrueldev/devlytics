---
import { dictionaryFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
const tag = '<script defer src="https://devlytics.gabrueldev.com/t.js"></script>';
---

<section class="section install" id="install" data-install>
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">{t.install.title}</h2>
      <p class="section-sub">{t.install.sub}</p>
    </div>

    <div class="install-layout">
      <div class="install-editor glass-plate reveal">
        <div class="editor-bar">
          <span></span><span></span><span></span>
          <p>index.html</p>
        </div>
        <pre class="editor-code"><code><span class="line"><span class="ln">1</span><span class="muted">&lt;head&gt;</span></span><span class="line"><span class="ln">2</span>  <span class="muted">&lt;title&gt;Fulano · Dev&lt;/title&gt;</span></span><span class="line line--typed"><span class="ln">3</span>  <span class="typed" data-typewriter={tag}>{tag}</span><span class="caret" aria-hidden="true"></span></span><span class="line"><span class="ln">4</span><span class="muted">&lt;/head&gt;</span></span></code></pre>
        <ol class="install-steps">
          {
            t.install.steps.map((step, index) => (
              <li>
                <span class="step-number">{index + 1}</span>
                {step}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="install-found reveal">
        <p class="found-title">
          <span class="found-pulse" aria-hidden="true"></span>
          {t.install.found}
        </p>
        <div class="found-groups">
          {
            t.install.groups.map((group, groupIndex) => (
              <div class="found-group">
                <p class="found-name">{group.name}</p>
                <ul>
                  {group.items.map((item, itemIndex) => (
                    <li class="found-chip" style={`--order: ${groupIndex * 3 + itemIndex}`}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="found-note">{t.install.worksWith}</p>
        <p class="found-note">
          {t.install.optionalStart} <code>data-project="…"</code>. {t.install.optionalEnd}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .install-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .install-editor {
    overflow: hidden;
  }

  .editor-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .editor-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(17, 17, 22, 0.14);
  }

  .editor-bar p {
    margin-left: 0.75rem;
    color: var(--text-mute);
    font-size: 0.78rem;
  }

  .editor-code {
    margin: 0;
    padding: 1.1rem 0;
    overflow-x: auto;
    font-size: clamp(0.72rem, 1.5vw, 0.86rem);
    line-height: 1.9;
  }

  .line {
    display: block;
    padding-inline: 1rem 1.25rem;
    white-space: pre;
  }

  .line--typed {
    background: rgba(var(--brand-rgb), 0.07);
    box-shadow: inset 2px 0 0 var(--brand);
  }

  .ln {
    display: inline-block;
    width: 1.6rem;
    color: var(--text-mute);
    opacity: 0.6;
    user-select: none;
  }

  .muted {
    color: var(--text-mute);
  }

  .typed {
    color: var(--brand-deep);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--brand);
    opacity: 0;
  }

  [data-install].is-typing .caret {
    opacity: 1;
    animation: caret-blink 1s steps(2) infinite;
  }

  .install-steps {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 1.2rem 1.25rem 1.4rem;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 0.93rem;
  }

  .install-steps li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .found-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .found-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-mute);
    transition: background 0.4s var(--ease);
  }

  [data-install].is-found .found-pulse {
    background: var(--live);
  }

  .found-groups {
    display: grid;
    gap: 1.2rem;
    margin-top: 1.4rem;
  }

  .found-name {
    color: var(--text-mute);
    font-size: 0.85rem;
  }

  .found-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .found-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    font-size: 0.88rem;
    font-weight: 500;
    opacity: 0.35;
    transform: scale(0.96);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
    transition-delay: calc(var(--order) * 90ms);
  }

  .found-chip svg {
    color: var(--live);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    transition-delay: inherit;
  }

  [data-install].is-found .found-chip {
    opacity: 1;
    transform: none;
    box-shadow:
      0 0 0 1px rgba(22, 163, 74, 0.25),
      0 6px 16px -10px rgba(22, 163, 74, 0.5);
  }

  [data-install].is-found .found-chip svg {
    opacity: 1;
  }

  .found-note {
    margin-top: 1.4rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .found-note + .found-note {
    margin-top: 0.4rem;
  }

  @keyframes caret-blink {
    to {
      visibility: hidden;
    }
  }

  @media (min-width: 960px) {
    .install-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .found-chip,
    .found-chip svg,
    .found-pulse {
      transition: none;
    }

    [data-install].is-typing .caret {
      animation: none;
    }
  }
</style>
