---
import { dictionaryFor, type Locale } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
---

<footer class="footer">
  <canvas class="footer-soil" data-pixel-soil aria-hidden="true"></canvas>
  <div class="container footer-inner">
    <Logo />
    <nav class="footer-links" aria-label="Devlytics">
      <a href="#privacy">{t.footer.privacy}</a>
      <a href="https://gabrueldev.com" rel="noopener">{t.footer.portfolio}</a>
    </nav>
    <p class="footer-copy">© 2026 {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 3rem 0 3.25rem;
    background: #5d3a1a;
    color: #fbefe0;
  }

  .footer-soil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .footer :global(.logo-name b) {
    color: #8aa4ff;
  }

  .footer-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: rgba(251, 239, 224, 0.82);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #fff8ee;
  }

  .footer-copy {
    color: rgba(251, 239, 224, 0.66);
    font-size: 0.85rem;
  }
</style>
