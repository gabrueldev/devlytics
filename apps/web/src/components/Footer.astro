---
import { dictionaryFor, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
---

<footer class="footer">
  <canvas class="footer-soil" data-pixel-soil aria-hidden="true"></canvas>
  <div class="container footer-inner">
    <img class="footer-logo" src="/brand/lockup-light.png" width="360" height="440" alt="Devlytics, developers tracking" loading="lazy" decoding="async" />
    <nav class="footer-links" aria-label="Devlytics">
      <a href="#privacy">{t.footer.privacy}</a>
      <a href="https://gabrueldev.com" rel="noopener">{t.footer.portfolio}</a>
    </nav>
    <p class="footer-copy">© 2026 {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 3rem 0 3.25rem;
    background: #5d3a1a;
    color: #fbefe0;
  }

  .footer-soil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .footer-logo {
    width: auto;
    height: clamp(8.5rem, 18vw, 11rem);
  }

  .footer-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: rgba(251, 239, 224, 0.82);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #fff8ee;
  }

  .footer-copy {
    color: rgba(251, 239, 224, 0.66);
    font-size: 0.85rem;
  }
</style>
