---
import { dictionaryFor, type Locale } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
---

<footer class="footer">
  <div class="container footer-inner">
    <Logo />
    <nav class="footer-links" aria-label="Devlytics">
      <a href="#privacy">{t.footer.privacy}</a>
      <a href="https://gabrueldev.com" rel="noopener">{t.footer.portfolio}</a>
    </nav>
    <p class="footer-copy">© 2026 {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: var(--text-soft);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-copy {
    color: var(--text-mute);
    font-size: 0.85rem;
  }
</style>
