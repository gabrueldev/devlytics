---
interface Props {
  projects: string[];
  attentionLabel: string;
}

const { projects, attentionLabel } = Astro.props;
const readings = [
  { share: 0.92, time: "1:42" },
  { share: 0.58, time: "0:58" },
  { share: 0.31, time: "0:31" },
];
---

<div class="preview" aria-hidden="true" data-orb-ring>
  <div class="preview-window glass-plate" data-glow>
    <div class="preview-bar">
      <span></span><span></span><span></span>
      <p class="preview-url">fulano.dev</p>
    </div>
    <div class="preview-viewport">
      <div class="preview-page">
        <div class="pp-nav"><i></i><b></b><b></b><b></b></div>
        <div class="pp-hero"><i></i><i class="short"></i><b></b></div>
        <div class="pp-projects">
          {
            projects.map((project, index) => (
              <div class="pp-card" style={`--heat: ${readings[index]?.share ?? 0.3}; --delay: ${index * 1.4}s`}>
                <span class="pp-heat" />
                <span class="pp-thumb" />
                <p>{project}</p>
                <i />
              </div>
            ))
          }
        </div>
        <div class="pp-about"><i></i><i></i><i class="short"></i></div>
        <div class="pp-contact"><b></b></div>
      </div>
    </div>
  </div>

  <div class="preview-panel glass-plate" data-glow style="--sheen-delay: 0.6s">
    <p class="panel-title"><span class="panel-dot"></span>{attentionLabel}</p>
    <ul>
      {
        projects.map((project, index) => (
          <li style={`--share: ${readings[index]?.share ?? 0.3}; --delay: ${0.9 + index * 0.18}s`}>
            <span class="panel-name">{project}</span>
            <span class="panel-time">{readings[index]?.time}</span>
            <span class="panel-track">
              <span class="panel-fill" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .preview {
    position: relative;
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
    padding-bottom: 3.5rem;
    animation: preview-in 1s var(--ease) 0.3s backwards;
  }

  .preview-window {
    position: relative;
    overflow: hidden;
  }

  .preview-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .preview-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(17, 17, 22, 0.14);
  }

  .preview-url {
    margin-left: 0.75rem;
    padding: 0.15rem 0.8rem;
    border-radius: 999px;
    background: rgba(17, 17, 22, 0.05);
    color: var(--text-mute);
    font-size: 0.75rem;
  }

  .preview-viewport {
    height: clamp(17rem, 34vw, 21rem);
    overflow: hidden;
    mask-image: linear-gradient(#000 82%, transparent);
  }

  .preview-page {
    display: grid;
    gap: 1.4rem;
    padding: 1.2rem 1.4rem 2rem;
    animation: page-scroll 14s var(--ease) 1.4s infinite;
  }

  .preview-page i,
  .preview-page b {
    display: block;
    height: 8px;
    border-radius: 99px;
    background: rgba(17, 17, 22, 0.1);
  }

  .preview-page b {
    background: rgba(17, 17, 22, 0.18);
  }

  .pp-nav {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .pp-nav i {
    width: 22%;
    height: 10px;
    margin-right: auto;
    background: rgba(17, 17, 22, 0.22);
  }

  .pp-nav b {
    width: 9%;
    height: 6px;
  }

  .pp-hero {
    display: grid;
    gap: 0.55rem;
    padding-block: 0.8rem;
  }

  .pp-hero i {
    height: 16px;
    width: 78%;
    background: rgba(17, 17, 22, 0.2);
  }

  .pp-hero i.short {
    width: 52%;
  }

  .pp-hero b {
    width: 26%;
    height: 22px;
    margin-top: 0.4rem;
    background: var(--text);
  }

  .pp-projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  .pp-card {
    position: relative;
    display: grid;
    gap: 0.45rem;
    padding: 0.6rem;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }

  .pp-heat {
    position: absolute;
    inset: -14px;
    border-radius: 22px;
    background: radial-gradient(
      closest-side,
      rgba(var(--brand-rgb), calc(var(--heat) * 0.55)),
      rgba(var(--brand-rgb), 0)
    );
    opacity: 0.15;
    animation: heat-pulse 4.2s ease-in-out var(--delay) infinite;
    pointer-events: none;
  }

  .pp-thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    background: linear-gradient(135deg, #e6e9f2, #f4f5f8);
  }

  .pp-card p {
    position: relative;
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .pp-card i {
    position: relative;
    width: 70%;
    height: 5px;
  }

  .pp-about {
    display: grid;
    gap: 0.5rem;
  }

  .pp-about i.short {
    width: 60%;
  }

  .pp-contact b {
    width: 40%;
    height: 26px;
    border-radius: 99px;
  }

  .preview-panel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(17.5rem, 78%);
    padding: 1rem 1.1rem 1.1rem;
  }

  .panel-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .panel-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.15);
  }

  .preview-panel ul {
    display: grid;
    gap: 0.7rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .preview-panel li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 0.5rem;
    font-size: 0.76rem;
  }

  .panel-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .panel-time {
    color: var(--text-mute);
    font-variant-numeric: tabular-nums;
  }

  .panel-track {
    grid-column: 1 / -1;
    height: 6px;
    border-radius: 99px;
    background: rgba(17, 17, 22, 0.07);
    overflow: hidden;
  }

  .panel-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand), #6f8cff);
    transform: scaleX(var(--share));
    transform-origin: left;
    animation: fill-in 1.1s var(--ease) var(--delay) backwards;
  }

  @media (min-width: 1000px) {
    .preview-panel {
      right: -1.5rem;
    }
  }

  @keyframes preview-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes page-scroll {
    0%,
    12% {
      transform: translateY(0);
    }
    40%,
    62% {
      transform: translateY(-34%);
    }
    88%,
    100% {
      transform: translateY(0);
    }
  }

  @keyframes heat-pulse {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes fill-in {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview,
    .preview-page,
    .panel-fill {
      animation: none;
    }

    .pp-heat {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
