---
import { dashboardPathFor } from "../config/dashboard";
import { dictionaryFor, type Locale } from "../i18n";
import HeroPreview from "./HeroPreview.astro";
import InstallTag from "./InstallTag.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
---

<section class="hero">
  <div class="dot-grid" aria-hidden="true"></div>
  <canvas class="hero-orb" data-orb data-orb-scale="1.25" aria-hidden="true"></canvas>
  <div class="hero-layout container">
    <div class="hero-copy">
      <h1 class="hero-title">
        <span class="hero-line">{t.hero.titleStart}</span>
        <span class="hero-line hero-line--accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-tag">
        <InstallTag label={t.hero.tagLabel} copy={t.hero.copy} copied={t.hero.copied} />
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={dashboardPathFor(locale)}>
          {t.hero.primary}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <p class="hero-note">{t.hero.note}</p>
      </div>
    </div>
    <HeroPreview projects={t.hero.previewProjects} attentionLabel={t.hero.previewAttention} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(7.5rem, 14vw, 10rem) 0 clamp(4rem, 8vw, 6rem);
    overflow: clip;
  }

  .hero-orb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 4.5rem);
    align-items: center;
  }

  .hero-title {
    margin-top: 1.4rem;
    font-size: clamp(2.6rem, 7.2vw, 5rem);
  }

  .hero-line {
    display: block;
    animation: hero-in 0.8s var(--ease) 0.12s backwards;
  }

  .hero-line--accent {
    color: var(--brand);
    animation-delay: 0.24s;
  }

  .hero-sub {
    margin-top: 1.4rem;
    max-width: 34rem;
    color: var(--text-soft);
    font-size: clamp(1.02rem, 1.7vw, 1.15rem);
    animation: hero-in 0.7s var(--ease) 0.36s backwards;
  }

  .hero-tag {
    margin-top: 2rem;
    max-width: 34rem;
    animation: hero-in 0.7s var(--ease) 0.46s backwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.5rem;
    animation: hero-in 0.7s var(--ease) 0.56s backwards;
  }

  .hero-note {
    max-width: 19rem;
    color: var(--text-mute);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 1000px) {
    .hero-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line,
    .hero-sub,
    .hero-tag,
    .hero-actions {
      animation: none;
    }
  }
</style>
