{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "devlytics-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "devlytics.gabrueldev.com/api/*", "zone_name": "gabrueldev.com" }],
  "observability": { "enabled": true },
  "vars": {
    "CF_ACCOUNT_ID": "9f368c41dee97aef4e913f2a9d26d49a",
    "DEMO_DOMAIN": "gabrueldev.com",
    "EVENTS_DATASET": "devlytics_events",
    "COFFEE_OFFER_ID": "34qhf5x",
  },
  "ratelimits": [
    { "name": "CHECKOUT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devlytics",
      "database_id": "2af6c752-881e-4283-ad41-6135fd2b17e7",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
}
